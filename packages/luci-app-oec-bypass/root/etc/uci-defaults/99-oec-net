#!/bin/sh
# ---------------------------------------------------------------------------
# OEC（OneThing Edge Cube / RK3566）单网口旁路由 —— 首次启动默认值
#
# 执行时机：/etc/init.d/boot -> uci_apply_defaults()
#   /etc/config/network 由 preinit 阶段的 /lib/preinit/82_config_generate 生成
#   （其内部有 [ ! -s /etc/config/network ] 守卫），而 preinit 早于 init.d/boot。
#   所以这里对 network.lan 的修改不会被 config_generate 覆盖。
#
# 本脚本只在首次启动执行一次；返回 0 后会被 /etc/init.d/boot 自动删除，
# 因此之后在 LuCI 里怎么改都不会被重置。
# ---------------------------------------------------------------------------

# 正常情况下 network 已由 config_generate 生成；没有就留着下次启动再试
[ -f /etc/config/network ] || exit 1

# --- 1) LAN 口改为 DHCP 客户端：插上网线即从上游路由器自动获取 IP ---------
uci -q set network.lan.proto='dhcp'
uci -q delete network.lan.ipaddr
uci -q delete network.lan.netmask
uci -q delete network.lan.gateway
uci -q delete network.lan.dns

# --- 2) 旁路由：关掉本机 DHCP 服务，避免与主路由抢着发地址 -----------------
#        单网口设备若同时开着 DHCP server，局域网里就会出现两个 DHCP。
uci -q set dhcp.lan.ignore='1'
uci -q delete dhcp.lan.start
uci -q delete dhcp.lan.limit
uci -q delete dhcp.lan.leasetime
uci -q delete dhcp.lan.dhcpv4
uci -q delete dhcp.lan.dhcpv6
uci -q delete dhcp.lan.ra
uci -q delete dhcp.lan.ra_slaac
uci -q delete dhcp.lan.ra_flags
uci -q delete dhcp.lan.ndp
uci -q delete dhcp.lan.master

uci -q commit network
uci -q commit dhcp

exit 0
